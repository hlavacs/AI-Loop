  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "node --test out/test/*.test.js",
    "test:integration": "npm run compile && node out/test/integration/run.js",
    "package": "npm run compile && node scripts/package.mjs",
    "test:vsix": "npm run package && node out/test/integration/vsixRun.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.74.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "typescript": "~5.9.3"
  }
}
