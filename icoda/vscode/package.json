{
  "name": "icoda",
  "displayName": "ICODA",
  "publisher": "icoda",
  "description": "ICODA project and backend commands for VS Code.",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN backend/LICENSE.txt",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
