          "when": "view == icoda.specification",
          "group": "navigation"
        },
        {
          "command": "icoda.validateSpecification",
          "when": "view == icoda.specification",
          "group": "navigation"
        },
        {
          "command": "icoda.advancePhase",
          "when": "view == icoda.specification",
          "group": "navigation"
        },
        {
          "command": "icoda.selectProviderModel",
          "when": "view == icoda.specification",
          "group": "navigation"
        },
        {
          "command": "icoda.refreshIssues",
          "when": "view == icoda.issues",
          "group": "navigation"
        },
        {
          "command": "icoda.refreshCoverage",
          "when": "view == icoda.coverage",
          "group": "navigation"
        },
        {
          "command": "icoda.openFileView",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        },
        {
          "command": "icoda.openClassView",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        },
        {
          "command": "icoda.openMindMap",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        },
        {
          "command": "icoda.analyseProject",
          "when": "view == icoda.project",
          "group": "navigation"
        },
        {
          "command": "icoda.selectTarget",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        },
        {
          "command": "icoda.revealEntity",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        },
        {
          "command": "icoda.showCallView",
          "when": "view == icoda.project && icoda.projectOpen",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ICODA",
      "properties": {
        "icoda.backgroundPurposeComments": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Opt in to purpose-comment proposals after 30 seconds of ICODA/editor inactivity in a trusted workspace. Requires an installed selected provider, clean editor buffers and fresh analysis; waits for other workflows and proposal decisions. Makes one attempt per analysed revision. Review with Apply/Reject Purpose Comments; never applies automatically."
        },
        "icoda.autoAnalyse": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Refresh analysis after saved or external source changes. Waits for unsaved documents, active operations and proposal decisions. Disable to keep a recorded trace loaded while editing; Analyse Project remains available."
        },
        "icoda.providerSelection": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "description": "Compatibility mirror written by Select Provider/Model. ICODA project state is authoritative for the provider, executable and model shown and used by workflows; editing this setting does not override it. Use Select Provider/Model to change the project selection and ICODA's user default for new projects. Selection never invokes a provider or stores credentials."
        },
        "icoda.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Python executable path or command (no arguments). Empty uses ICODA's .icoda-venv, then python3/python on PATH. Run Restart Backend after changing this setting."
        },
        "icoda.toolchain.cmakePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "CMake executable path or command (no arguments). Empty uses Python's installed-tool discovery. Run Show Toolchain to inspect this override."
        },
        "icoda.toolchain.ninjaPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Ninja executable path or command (no arguments). Empty uses Python's installed-tool discovery. Run Show Toolchain to inspect this override."
        },
        "icoda.toolchain.clangPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Clang C++ driver (clang++ or clang++.exe), path or command without arguments. Requires Clang 16+ with sibling clang and clang-scan-deps. Empty uses Python's installed-tool discovery. Run Show Toolchain to inspect."
        },
        "icoda.toolchain.llvmSymbolizerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "llvm-symbolizer executable path or command (no arguments). Empty uses Python's installed-tool discovery. Run Show Toolchain to inspect this override."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
