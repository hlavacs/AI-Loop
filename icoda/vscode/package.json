  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "All ICODA views and commands except Show Output require workspace trust to start Python. The Project view shows only a placeholder until trusted.",
      "restrictedConfigurations": [
        "icoda.pythonPath",
        "icoda.toolchain.cmakePath",
        "icoda.toolchain.ninjaPath",
        "icoda.toolchain.clangPath",
        "icoda.toolchain.llvmSymbolizerPath"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "icoda.tracePrevious",
        "title": "Previous Call",
        "category": "ICODA",
        "enablement": "activeWebviewPanelId == icoda.callView && !editorTextFocus && !inputFocus && icoda.projectOpen && isWorkspaceTrusted"
      },
      {
        "command": "icoda.traceOver",
        "title": "Step Over",
        "category": "ICODA",
