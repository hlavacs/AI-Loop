      },
      {
        "command": "icoda.traceOver",
        "key": "ctrl+alt+down",
        "when": "activeWebviewPanelId == icoda.callView && !editorTextFocus && !inputFocus && icoda.projectOpen && isWorkspaceTrusted"
      },
      {
        "command": "icoda.traceInto",
        "key": "ctrl+alt+right",
        "when": "activeWebviewPanelId == icoda.callView && !editorTextFocus && !inputFocus && icoda.projectOpen && isWorkspaceTrusted"
      },
      {
        "command": "icoda.traceOut",
        "key": "ctrl+alt+up",
        "when": "activeWebviewPanelId == icoda.callView && !editorTextFocus && !inputFocus && icoda.projectOpen && isWorkspaceTrusted"
      },
      {
        "command": "icoda.traceReset",
        "key": "ctrl+alt+home",
        "when": "activeWebviewPanelId == icoda.callView && !editorTextFocus && !inputFocus && icoda.projectOpen && isWorkspaceTrusted"
      }
