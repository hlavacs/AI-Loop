    "onCommand:icoda.selectTarget",
    "onCommand:icoda.revealEntity",
    "onCommand:icoda.showCallView",
    "onCommand:icoda.showProposalCallView",
    "onCommand:icoda.openFileView",
    "onCommand:icoda.openClassView",
    "onCommand:icoda.openMindMap",
    "onCommand:icoda.revealInFileView",
    "onCommand:icoda.assignFileCluster",
    "onCommand:icoda.showOutput",
    "onCommand:icoda.showToolchain",
    "onCommand:icoda.refreshTargets",
    "onCommand:icoda.buildTarget",
    "onCommand:icoda.testProject",
    "onCommand:icoda.runTarget",
    "onCommand:icoda.recordTrace",
    "onCommand:icoda.restartBackend",
    "onCommand:icoda.refreshIssues",
    "onCommand:icoda.refreshCoverage",
    "onView:icoda.issues",
    "onView:icoda.coverage",
