{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["CONTINUE", "REPAIR", "DONE", "HUMAN_NEEDED"]
    },
    "reason": {
      "type": "string"
    },
    "history_summary": {
      "type": "string"
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed_work_units": { "type": "integer", "minimum": 0 },
        "remaining_work_units": { "type": "integer", "minimum": 0 },
        "remaining_minutes": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["completed_work_units", "remaining_work_units", "remaining_minutes"],
      "additionalProperties": false
    },
    "next_task": {
      "type": "object",
      "properties": {
        "goal": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "test_cmd": { "type": "string" }
      },
      "required": ["goal", "constraints", "acceptance", "test_cmd"],
      "additionalProperties": false
    }
  },
  "required": ["action", "reason", "history_summary", "progress"],
  "additionalProperties": false
}
