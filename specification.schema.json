{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-loop.local/schemas/specification.schema.json",
  "title": "AI-Loop Formal Specification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "objectives": { "$ref": "#/$defs/stringArray" },
    "in_scope": { "$ref": "#/$defs/stringArray" },
    "out_of_scope": { "$ref": "#/$defs/stringArray" },
    "stakeholders": { "$ref": "#/$defs/stringArray" },
    "assumptions": { "$ref": "#/$defs/stringArray" },
    "constraints": { "$ref": "#/$defs/stringArray" },
    "dependencies": { "$ref": "#/$defs/stringArray" },
    "use_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/useCase" }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/specificationDecision" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationCase" }
    },
    "open_questions": { "$ref": "#/$defs/stringArray" }
  },
  "required": [
    "schema_version",
    "title",
    "summary",
    "objectives",
    "in_scope",
    "out_of_scope",
    "stakeholders",
    "assumptions",
    "constraints",
    "dependencies",
    "use_cases",
    "requirements",
    "decisions",
    "risks",
    "verification",
    "open_questions"
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:[-_][A-Z0-9]+)*$",
      "maxLength": 64
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metricNameArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string" },
        "actors": { "$ref": "#/$defs/stringArray" },
        "preconditions": { "$ref": "#/$defs/stringArray" },
        "trigger": { "type": "string" },
        "main_flow": { "$ref": "#/$defs/stringArray" },
        "alternate_flows": { "$ref": "#/$defs/stringArray" },
        "postconditions": { "$ref": "#/$defs/stringArray" },
        "error_and_edge_cases": { "$ref": "#/$defs/stringArray" },
        "requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "required": [
        "id",
        "title",
        "actors",
        "preconditions",
        "trigger",
        "main_flow",
        "alternate_flows",
        "postconditions",
        "error_and_edge_cases",
        "requirement_ids"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "category": {
          "type": "string",
          "enum": ["functional", "quality", "interface", "data", "operational", "compliance"]
        },
        "priority": {
          "type": "string",
          "enum": ["must", "should", "could"]
        },
        "title": { "type": "string" },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "acceptance_criteria": { "$ref": "#/$defs/stringArray" },
        "source": { "type": "string" }
      },
      "required": [
        "id",
        "category",
        "priority",
        "title",
        "statement",
        "rationale",
        "acceptance_criteria",
        "source"
      ]
    },
    "specificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string" },
        "selected_decision": { "type": "string" },
        "rationale": { "type": "string" },
        "rejected_alternatives": { "$ref": "#/$defs/stringArray" },
        "consequences": { "$ref": "#/$defs/stringArray" }
      },
      "required": [
        "topic",
        "selected_decision",
        "rationale",
        "rejected_alternatives",
        "consequences"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "uncertainty": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "failure_modes": { "$ref": "#/$defs/stringArray" },
        "detection_signals": { "$ref": "#/$defs/stringArray" },
        "mitigations": { "$ref": "#/$defs/stringArray" },
        "verification_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "severity",
        "uncertainty",
        "failure_modes",
        "detection_signals",
        "mitigations",
        "verification_ids"
      ]
    },
    "validationLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_correction_attempts": { "type": "integer", "minimum": 1 },
        "repetitions_per_attempt": { "type": "integer", "minimum": 1 },
        "stagnation_limit": { "type": "integer", "minimum": 1 },
        "escalation_condition": { "type": "string" },
        "retain_evidence": { "type": "boolean" }
      },
      "required": [
        "maximum_correction_attempts",
        "repetitions_per_attempt",
        "stagnation_limit",
        "escalation_condition",
        "retain_evidence"
      ]
    },
    "metricAssertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "operator": {
          "type": "string",
          "enum": ["<", "<=", "==", "!=", ">=", ">"]
        },
        "threshold": { "type": "number" },
        "tolerance": {
          "anyOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        }
      },
      "required": ["metric", "operator", "threshold", "tolerance"]
    },
    "evidenceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
        "kind": {
          "type": "string",
          "enum": ["log", "structured-data", "intermediate-state", "trace", "image", "snapshot", "benchmark", "coverage", "reference-output", "comparison-result"]
        },
        "media_type": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "required": ["name", "kind", "media_type", "description", "requirement_ids"]
    },
    "coverageTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
        "coverage_type": {
          "type": "string",
          "enum": ["source-line", "branch", "interface", "scenario", "state-transition", "requirement", "fixture", "invariant", "platform"]
        },
        "description": { "type": "string", "minLength": 1 },
        "measurement_key": { "type": ["string", "null"] },
        "operator": {
          "anyOf": [
            { "type": "string", "enum": ["<", "<=", "==", "!=", ">=", ">"] },
            { "type": "null" }
          ]
        },
        "threshold": { "type": ["number", "null"] },
        "tolerance": {
          "anyOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "required_scenarios": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_kind": {
          "anyOf": [
            { "const": "coverage" },
            { "type": "null" }
          ]
        }
      },
      "required": ["name", "coverage_type", "description", "measurement_key", "operator", "threshold", "tolerance", "required_scenarios", "evidence_kind"]
    },
    "verificationCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string" },
        "requirement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        },
        "test_level": {
          "type": "string",
          "enum": ["static", "unit", "integration", "system", "acceptance", "property", "performance", "security", "visual"]
        },
        "method": {
          "type": "string",
          "enum": ["deterministic", "differential", "metamorphic", "statistical", "snapshot", "manual", "hybrid"]
        },
        "oracle": { "type": "string" },
        "fixtures": { "$ref": "#/$defs/stringArray" },
        "procedure": { "$ref": "#/$defs/stringArray" },
        "pass_criteria": { "$ref": "#/$defs/stringArray" },
        "declared_metrics": { "$ref": "#/$defs/metricNameArray" },
        "metric_assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/metricAssertion" }
        },
        "coverage_targets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/coverageTarget" }
            ]
          }
        },
        "automation": {
          "type": "string",
          "enum": ["automated", "manual", "hybrid"]
        },
        "blocking": { "type": "boolean" },
        "validation_loop": { "$ref": "#/$defs/validationLoop" },
        "command_override": {
          "anyOf": [
            { "type": "string", "minLength": 1, "pattern": "\\S" },
            { "type": "null" }
          ]
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "timeout": { "type": "integer", "minimum": 1 },
        "required_evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/evidenceDeclaration" }
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "requirement_ids",
        "test_level",
        "method",
        "oracle",
        "fixtures",
        "procedure",
        "pass_criteria",
        "declared_metrics",
        "metric_assertions",
        "coverage_targets",
        "automation",
        "blocking",
        "validation_loop",
        "command_override",
        "working_directory",
        "timeout",
        "required_evidence"
      ]
    }
  }
}
